{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run typecheck && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/sed-command-center run build",
  "outputDirectory": "artifacts/sed-command-center/dist/public",
  "installCommand": "npx -y pnpm@10.30.3 install --frozen-lockfile",
  "framework": null,
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__p=/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
