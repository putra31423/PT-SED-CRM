# Copy this file to `.env` and adjust. `.env` is git-ignored.

# --- Option A: embedded database, no server required (default for local dev) ---
# A `file:` URL runs PGlite: real Postgres compiled to WASM, running inside the
# API process and persisted to the given directory. Use an ABSOLUTE path — the
# API server and drizzle-kit run from different working directories.
# Create the parent directory first: PGlite does not create it recursively.
DATABASE_URL=file:/absolute/path/to/this/repo/.data/pglite

# --- Option B: a real Postgres server (Supabase, Neon, Replit, ...) ---
# Supabase → Project Settings → Database → Connection string → URI (Session
# pooler, port 5432). URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Port the Express API listens on. The Vite dev server proxies /api here.
# Not 5000 on macOS — AirPlay Receiver (ControlCenter) already owns that port.
PORT=5001
