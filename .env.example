# Copy this file to `.env` and adjust. `.env` is git-ignored.

# Postgres connection string. Supabase → Connect → Direct → Type: URI.
# URL-encode special characters in the password (@ -> %40, # -> %23, % -> %25).
#
#   Local / any long-running server : Session pooler,     port 5432
#   Vercel and other serverless     : Transaction pooler, port 6543
#
# Serverless opens a fresh connection per request and never closes it cleanly,
# so the session pooler runs out of slots once traffic picks up.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Port the Express API listens on. The Vite dev server proxies /api here.
# Not 5000 on macOS — AirPlay Receiver (ControlCenter) already owns that port.
PORT=5001

# --- Auth (Supabase) ---
# Project URL. The API uses it to fetch the JWKS that verifies access tokens;
# the frontend uses it to sign in. Not a secret.
SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key — public by design, it ships inside the frontend bundle.
# It grants no data access: every table has RLS on with no permissive policies.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Comma-separated browser origins allowed to call the API. Leave empty for
# same-origin only, which is what both the Vite dev proxy and Vercel use.
CORS_ORIGIN=
